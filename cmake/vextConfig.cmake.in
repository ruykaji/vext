@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/vextCpuTargets.cmake")

set(vext_cpu_FOUND TRUE)
set(vext_cuda_FOUND FALSE)

foreach(component IN LISTS vext_FIND_COMPONENTS)
	if(component STREQUAL "cpu")
		continue()
	elseif(component STREQUAL "cuda")
		if(@VEXT_CUDA_AVAILABLE@)
			find_dependency(CUDAToolkit)
			include("${CMAKE_CURRENT_LIST_DIR}/vextCudaTargets.cmake")
			set(vext_cuda_FOUND TRUE)
		endif()
	else()
		set(vext_${component}_FOUND FALSE)
	endif()
endforeach()

check_required_components(vext)
